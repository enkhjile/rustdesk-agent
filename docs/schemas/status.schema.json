{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent status v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_uuid",
    "rustdesk_id",
    "rustdesk_version",
    "desired_revision",
    "applied_revision",
    "results",
    "observation_sequence"
  ],
  "properties": {
    "management_mode": {"enum": ["observe_only", "managed"]},
    "schema_version": {
      "const": 1
    },
    "agent_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "rustdesk_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rustdesk_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "desired_revision": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "applied_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "null"
        }
      ]
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approve_mode": {
          "enum": [
            "verified",
            "read_failed",
            "write_failed",
            "mismatch",
            "unsupported",
            "unverified_cli_match",
            "indeterminate"
          ]
        },
        "verification_method": {
          "enum": [
            "verified",
            "read_failed",
            "write_failed",
            "mismatch",
            "unsupported",
            "unverified_cli_match",
            "indeterminate"
          ]
        }
      }
    },
    "observation_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  },
  "if": {"properties": {"desired_revision": {"type": "null"}}},
  "then": {"properties": {"results": {"maxProperties": 0}, "applied_revision": {"type": "null"}}},
  "else": {"properties": {"results": {"minProperties": 1}}}
}
