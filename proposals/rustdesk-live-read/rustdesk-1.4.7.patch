+// Read-only CLI path: never read or update the caller's configuration cache.
+// The caller bounds the complete connect/send/receive exchange to one second.
+#[cfg(windows)]
+pub async fn get_options_live() -> Result<HashMap<String, String>, ()> {
+    let mut connection = connect(1000, "").await.map_err(|_| ())?;
+    connection
+        .send(&Data::Options(None))
+        .await
+        .map_err(|_| ())?;
+    match connection.next_timeout(1000).await.map_err(|_| ())? {
+        Some(Data::Options(Some(options))) => Ok(options),
+        _ => Err(()),
+    }
+}
